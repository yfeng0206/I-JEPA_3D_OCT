__pycache__/
*.pyc
*.egg-info/
.cache/
*.pt
*.pth
*.pth.tar
checkpoints/
data/
outputs/
*.log
.env
configs/aml_*.yml

# Don't commit raw execution logs (may contain hostnames/IPs)
results/**/eval_stdout.log
results/**/torchrun_stdout.log

# Exclude large pretraining logs (per-iteration CSVs, 6-23MB; MIRAGE arm is 104MB)
results/pretraining/*/jepa_patch-log.csv
results/pretraining/*/jepa_patch_*-log.csv
results/phase0_local_examples/

# Local-only working artifacts (not for PR)
.audit/
.vs/
.vscode/
_tmp_*
MASKING_PLAN.md

# Node OOM crash dumps
report.*.json

# Regenerable sweep intermediates (adapter_sweep.py --sweep re-creates)
results/**/*.npz
# ...but per-volume predictions are evidence, not intermediates. They are the
# only record of a run's per-sample output and cannot be regenerated without the
# original checkpoint + dataset, so they must always be committed. Losing them
# is what previously made cross-machine paired bootstrap tests impossible.
!results/**/*_test_predictions.npz
!results/**/*_val_predictions.npz
