      "-u",
      "src/eval_downstream.py",
      "--config",
      "{probe_config}",
      "--encoder-checkpoint",
      "{checkpoint}",
      "--output-dir",
      "{out_dir}",
      "--head-seeds",
      "{head_seeds}",
      "--seal-test",
      "--extra-pooling",
      "patch_max",
      "--arm",
      "{arm}",
      "--train-seed",
      "{seed}",
      "--role",
      "new",
      "--run-uuid",
      "{run_uuid}",
      "--run-provenance",
      "{run_provenance}"
    ],
    "anchor_command": [
      "{python}",
      "-u",
      "src/eval_downstream.py",
      "--config",
      "{probe_config}",
      "--encoder-checkpoint",
      "{checkpoint}",
      "--output-dir",
      "{out_dir}",
      "--head-seeds",
      "{head_seeds}",
      "--seal-test",
      "--extra-pooling",
      "patch_max",
      "--arm",
      "{arm}",
